<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%-- The URL the browser asked for, used to mark the current page in the navigation --%>
<c:set var="currentPath" value="${requestScope['jakarta.servlet.forward.request_uri']}"/>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> | RoadReady Rentals</title>
    <link rel="stylesheet" href="<c:url value='/webjars/bootstrap/5.3.8/css/bootstrap.min.css'/>">
    <link rel="stylesheet" href="<c:url value='/css/app.css'/>">
</head>
<body>
<c:choose>
    <c:when test="${sessionScope.currentUser.admin}">
<div class="admin-shell">
    <aside class="admin-side">
        <a class="app-brand" href="<c:url value='/admin'/>"><span class="plate plate-sm"><span class="plate-text">RR</span></span>RoadReady</a>
        <nav class="admin-nav" aria-label="Staff">
            <a href="<c:url value='/admin'/>" ${currentPath == '/admin' ? 'aria-current="page"' : ''}>Dashboard</a>
            <a href="<c:url value='/admin/bookings'/>" ${fn:startsWith(currentPath, '/admin/bookings') ? 'aria-current="page"' : ''}>Bookings</a>
            <a href="<c:url value='/admin/vehicles'/>" ${fn:startsWith(currentPath, '/admin/vehicles') ? 'aria-current="page"' : ''}>Fleet</a>
            <a href="<c:url value='/admin/audit'/>" ${fn:startsWith(currentPath, '/admin/audit') ? 'aria-current="page"' : ''}>Audit log</a>
            <a class="admin-nav-split" href="<c:url value='/vehicles'/>" ${fn:startsWith(currentPath, '/vehicles') ? 'aria-current="page"' : ''}>Customer site</a>
        </nav>
        <div class="admin-user">
            <span class="app-nav-user"><c:out value="${sessionScope.currentUser.fullName}"/></span>
            <form method="post" action="<c:url value='/logout'/>" class="m-0">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Log out</button>
            </form>
        </div>
    </aside>
    <div class="admin-body">
<main class="admin-main">
    </c:when>
    <c:otherwise>
<nav class="navbar navbar-expand-lg app-nav">
    <div class="container">
        <a class="app-brand navbar-brand" href="<c:url value='/'/>"><span class="plate plate-sm"><span class="plate-text">RR</span></span>RoadReady</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="<c:url value='/vehicles'/>" ${fn:startsWith(currentPath, '/vehicles') ? 'aria-current="page"' : ''}>Vehicles</a></li>
                <c:if test="${not empty sessionScope.currentUser}">
                    <li class="nav-item"><a class="nav-link" href="<c:url value='/bookings'/>" ${fn:startsWith(currentPath, '/bookings') ? 'aria-current="page"' : ''}>My bookings</a></li>
                </c:if>
            </ul>
            <div class="d-flex align-items-center gap-2">
                <c:choose>
                    <c:when test="${not empty sessionScope.currentUser}">
                        <span class="app-nav-user"><c:out value="${sessionScope.currentUser.fullName}"/></span>
                        <form method="post" action="<c:url value='/logout'/>" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Log out</button>
                        </form>
                    </c:when>
                    <c:otherwise>
                        <a class="btn btn-sm btn-outline-secondary" href="<c:url value='/login'/>">Log in</a>
                        <a class="btn btn-sm btn-primary" href="<c:url value='/register'/>">Sign up</a>
                    </c:otherwise>
                </c:choose>
            </div>
        </div>
    </div>
</nav>
<main class="container py-4">
    </c:otherwise>
</c:choose>
    <c:if test="${not empty success}">
        <div class="alert alert-success" role="status"><c:out value="${success}"/></div>
    </c:if>
    <c:if test="${not empty error}">
        <div class="alert alert-danger" role="alert"><c:out value="${error}"/></div>
    </c:if>
    <c:if test="${not empty errors}">
        <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
                <c:forEach var="message" items="${errors}"><li><c:out value="${message}"/></li></c:forEach>
            </ul>
        </div>
    </c:if>
